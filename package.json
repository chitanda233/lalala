{
  "name": "lalala",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "一个关于配方、等待和放松的小游戏。",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs --preview",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check:docs": "node scripts/generate-content-docs.mjs --check",
    "verify": "npm run check && npm run check:docs && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
